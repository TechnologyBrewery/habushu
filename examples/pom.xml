<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.technologybrewery.habushu</groupId>
        <artifactId>habushu</artifactId>
        <version>3.4.1</version>
    </parent>

    <artifactId>examples</artifactId>
    <packaging>pom</packaging>

    <name>habushu::Examples</name>

    <modules>
        <module>habushu-managed-dependencies</module>
        <module>habushu-default-python-strategy</module>
        <module>habushu-running-python-scripts</module>
        <module>habushu-containerize</module>
        <module>poetry</module>
        <module>uv</module>
    </modules>

    <properties>
        <version.fabric8.docker.maven.plugin>0.45-tb-0.1.0</version.fabric8.docker.maven.plugin>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.technologybrewery.habushu</groupId>
                <artifactId>habushu-maven-plugin</artifactId>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.technologybrewery.habushu</groupId>
                    <artifactId>habushu-maven-plugin</artifactId>
                    <!-- Since we're working in the habushu repo, we must set the project version dynamically -->
                    <!-- Outside of this repo, the version should be hardcoded here or in the parent pom -->
                    <version>${project.version}</version>
                    <!-- This configuration allows Habushu to extend/customize the Maven build lifecycle,
                    which is required for the plugin to function -->
                    <extensions>true</extensions>
                    <configuration>
                        <!-- Skips any scenarios tagged with @integration-test - these will
                            be executed via the "integration-test" Maven profile -->
                        <behaveOptions>--tags ~integration_test</behaveOptions>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>org.technologybrewery.habushu</groupId>
                            <artifactId>habushu-maven-plugin</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.technologybrewery.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>${version.fabric8.docker.maven.plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <!-- NB: workaround to trigger build cache invalidation when a new SNAPSHOT is available-->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>habushu-maven-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
