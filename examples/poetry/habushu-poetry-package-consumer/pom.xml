<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.technologybrewery.habushu</groupId>
        <artifactId>poetry</artifactId>
        <version>3.4.0</version>
    </parent>

    <name>habushu::Examples::Poetry::Consume a Local Package</name>
    <description>Example of how to use the habushu-maven-plugin to consume other Habushu modules</description>

    <artifactId>habushu-poetry-package-consumer</artifactId>
    <packaging>habushu</packaging>

    <build>
        <directory>dist</directory>
        <plugins>
            <plugin>
                <groupId>org.technologybrewery.habushu</groupId>
                <artifactId>habushu-maven-plugin</artifactId>
                <configuration>
                    <rewriteLocalPathDepsInArchives>true</rewriteLocalPathDepsInArchives>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>tagged-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.technologybrewery.habushu</groupId>
                        <artifactId>habushu-maven-plugin</artifactId>
                        <configuration>
                            <behaveExcludeManualTag>false</behaveExcludeManualTag>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <!-- Specify habushu-poetry-package as a dependency so that this module's build is dependent upon it -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>habushu-poetry-package</artifactId>
            <version>${project.version}</version>
            <type>habushu</type>
        </dependency>
    </dependencies>

</project>
